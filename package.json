{
  "name": "themis-spec",
  "version": "0.1.0",
  "description": "Open format and reference CLI for spec-driven agentic development with a verification loop",
  "keywords": [
    "spec-driven",
    "agents",
    "ai",
    "verification",
    "acceptance-tests",
    "cli"
  ],
  "homepage": "https://albz.it/themis/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlbertoBarrago/themis.git"
  },
  "bugs": {
    "url": "https://github.com/AlbertoBarrago/themis/issues"
  },
  "type": "module",
  "license": "MIT",
  "bin": {
    "themis": "dist/cli/main.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "SPEC_FORMAT.md",
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
