{
  "name": "themis-spec",
  "version": "0.0.0",
  "description": "Open format and reference CLI for spec-driven agentic development with a verification loop",
  "type": "module",
  "license": "MIT",
  "bin": {
    "themis": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "templates",
    "SPEC_FORMAT.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
